( First 10 Fibonacci numbers, one per line.            )
( a and b live in the field; the stack holds only the  )
( loop counter, which stays on top as the condition.   )
0 0 p            ( field[0] = a = 0 )
1 1 p            ( field[1] = b = 1 )
10               ( counter )
[
  0 g . 10 @     ( print a, then newline )
  0 g 1 g +      ( push a + b )
  1 g 0 p        ( a = b )
  1 p            ( b = a + b )
  1 -            ( counter-- )
]
